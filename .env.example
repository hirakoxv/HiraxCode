# ── HiraxCode configuration ─────────────────────────────────────────────
# Everything here is optional. You can configure providers, keys, models and
# more interactively from inside the app with /settings (saved to
# ~/.config/hiraxcode/config.json).

# Pick a provider explicitly: openrouter, openai, anthropic, google, groq,
# deepseek, mistral, xai, together, fireworks, cerebras, river, freellmapi,
# ollama, lmstudio, llamacpp, gguf, custom
# HIRAX_PROVIDER=openrouter

# Default model (provider-specific)
MODEL=openrouter/auto

# ── API keys (set the ones you use) ─────────────────────────────────────
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
CEREBRAS_API_KEY=
RIVER_API_KEY=
# FreeLLMAPI local router (http://localhost:3001/v1)
FREELLMAPI_API_KEY=

# Override the base URL for the selected provider (proxies, self-hosted, …)
# BASE_URL=https://openrouter.ai/api/v1

# OpenRouter attribution headers (optional)
SITE_URL=https://github.com
SITE_NAME=HiraxCode

# ── Local GGUF models (llama.cpp) ───────────────────────────────────────
# Path to a .gguf file. HiraxCode spawns llama-server automatically (and
# downloads a prebuilt llama.cpp if one isn't found in PATH).
# GGUF_PATH=/models/qwen2.5-coder-7b-instruct-q4_k_m.gguf
# Path to the llama-server binary (default: found in PATH, else auto-download)
# LLAMA_SERVER_BIN=llama-server
# Optional multimodal projector (.mmproj) — enables image input for GGUF models
# MMPROJ_PATH=/models/mmproj-model-f16.gguf

# ── Behaviour ───────────────────────────────────────────────────────────
# 0 = let the provider decide
MAX_TOKENS=0
# 0.0 - 1.0 (above 1.0 the model output degrades)
TEMPERATURE=0.2
# Enable model reasoning/thinking stream (if supported)
ENABLE_REASONING=true
# low | medium | high
REASONING_EFFORT=medium
# Auto-approve read-only tools (read_file, list_dir, glob)
AUTO_APPROVE_SAFE_TOOLS=true
# Auto-approve EVERY tool, no confirmation prompts (same as /yolo)
AUTO_APPROVE_ALL=false
# Working directory for the agent (defaults to current directory)
WORKING_DIR=
# Show the sessions sidebar on start
SHOW_SIDEBAR=false
# UI accent colour (hex)
# ACCENT=#22d3ee
# Verbose logs to stderr as well as ~/.local/state/hiraxcode/hiraxcode.log
DEBUG=false
